ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL_ID=your-model-id
PRIMARY_MODEL_TIER=strong

# Optional model failover and complexity routing
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL_ID=
FALLBACK_MODEL_TIER=strong
LIGHT_MODEL_ID=

# DashScope OpenAI-compatible Embedding API
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
EMBEDDING_DIMENSION=2048

# Elasticsearch vector store
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# Trace budgets and model cost estimation (optional)
TRACE_MAX_TOKENS=
TRACE_MAX_SECONDS=
TRACE_MAX_COST=
MODEL_INPUT_PRICE_PER_MILLION=0
MODEL_OUTPUT_PRICE_PER_MILLION=0
